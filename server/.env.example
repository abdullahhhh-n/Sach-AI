# Sach-AI backend configuration. Copy to .env and adjust.

# Port the API listens on (the Vite dev server proxies /api here).
PORT=8787

# SQLite file location (created automatically).
DATABASE_PATH=./data/sach.db

# Secret used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Token lifetimes.
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30

# Origin of the frontend (CORS in development).
CLIENT_ORIGIN=http://localhost:8080

# Python inference microservice (ml-service/) running the pre-trained
# ResNeXt50+LSTM deepfake detector. If it is unreachable, scans fall back to
# a deterministic local simulator.
ML_SERVICE_URL=http://127.0.0.1:8600
ML_TIMEOUT_MS=300000

# Frames sampled per video. Must match an available weight file
# (10, 20, 40, 60, 80, 100 - see ml-service/models/). 60 frames pairs with
# model_97_acc_60_frames_FF_data.pt (97% FaceForensics++ validation accuracy);
# use 20 with model_90_acc_20_frames_FF_data.pt for ~3x faster scans.
SEQUENCE_LENGTH=60

# Upload limit per video.
MAX_VIDEO_MB=200
